// ============================================================================
// Reklu Prisma Schema
// ----------------------------------------------------------------------------
// Phase 1-3 models. Phase 4+ (skills, MCP, connectors, artifacts, agents,
// billing) are added in subsequent migration files; see docs/ARCHITECTURE.md.
//
// Database: PostgreSQL for both local dev and production.
// The Prisma `provider` cannot be parameterized via DATABASE_URL — it must be
// committed to one value. We use postgresql everywhere so the same schema
// works in dev and in the Dokploy deployment.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTH & IDENTITY
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  // Profile
  bio           String?
  // Preferences
  preferredModelId String?
  preferredAuto    Boolean   @default(true)
  // Admin
  isAdmin       Boolean   @default(false)
  isSuspended   Boolean   @default(false)
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Soft delete
  deletedAt     DateTime?

  // Relations
  accounts         Account[]
  sessions         Session[]
  memberships      Membership[]
  ownedOrgs        Organization[]   @relation("OrgOwner")
  conversations    Conversation[]
  messages         Message[]
  providerCreds    ProviderCredential[]
  usageEvents      UsageEvent[]
  creditEntries    CreditLedgerEntry[]
  notifications    Notification[]
  apiKeys          ApiKey[]
  createdSkills    Skill[]

  @@index([email])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  hashedKey  String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  scopes     String    @default("[]") // JSON array of scope strings
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// ORGANIZATIONS & MEMBERSHIPS
// ============================================================================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  ownerId     String
  image       String?
  // Billing
  plan        String   @default("free") // free | pro | team | enterprise
  // Settings
  settings    String   @default("{}") // JSON
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  owner       User         @relation("OrgOwner", fields: [ownerId], references: [id])
  memberships Membership[]
  conversations Conversation[]
  projects     Project[]
  providerCreds ProviderCredential[]
  usageEvents  UsageEvent[]
  creditEntries CreditLedgerEntry[]
  invitations  Invitation[]

  @@index([slug])
  @@index([ownerId])
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("member") // owner | admin | member | viewer
  // Timestamps
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String   @default("member")
  token          String   @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

// ============================================================================
// PROJECTS (Phase 7 — schema present, UI minimal in Phase 1-3)
// ============================================================================

model Project {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  // Settings
  systemPrompt   String?
  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([organizationId])
}

// ============================================================================
// CONVERSATIONS & MESSAGES
// ============================================================================

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  projectId      String?
  title          String   @default("New chat")
  // State
  isArchived     Boolean  @default(false)
  isPinned       Boolean  @default(false)
  isTemporary    Boolean  @default(false)
  // Last-message cache for sidebar
  lastMessageAt  DateTime @default(now())
  lastMessagePreview String?
  // Default model for the conversation
  defaultModelId String?
  // Branching
  parentId       String?
  branchFromMessageId String?
  // Token totals (denormalized for usage page)
  totalInputTokens  Int @default(0)
  totalOutputTokens Int @default(0)
  totalCostMicros   Int @default(0) // cost in micro-cents to avoid floats
  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent       Conversation? @relation("ConversationBranches", fields: [parentId], references: [id], onDelete: SetNull)
  branches     Conversation[] @relation("ConversationBranches")
  messages     Message[]
  usageEvents  UsageEvent[]

  @@index([organizationId, lastMessageAt])
  @@index([userId, lastMessageAt])
  @@index([projectId])
  @@index([deletedAt])
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  userId          String?  // null for assistant
  role            String   // user | assistant | system | tool
  // Content
  content         String   @default("") // final rendered content
  // Request/response metadata
  modelProviderId String?  // "openai" | "anthropic" | "google" | ...
  modelId         String?  // specific model used
  reasoningSummary String? // high-level reasoning summary (no hidden CoT)
  // Tokens
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  costMicros      Int      @default(0)
  // Latency
  latencyMs       Int?
  timeToFirstTokenMs Int?
  // Finish
  finishReason    String?  // stop | length | tool_use | content_filter | error
  // Error
  errorCode       String?
  errorMessage    String?
  // Ordering
  ordinal         Int      // sequence within conversation
  // Branching
  parentMessageId String?
  // Timestamps
  createdAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  parts        MessagePart[]

  @@unique([conversationId, ordinal])
  @@index([conversationId, createdAt])
  @@index([userId])
}

model MessagePart {
  id        String   @id @default(cuid())
  messageId String
  type      String   // text | image | file | tool_call | tool_result | citation
  ordinal   Int
  // Content (JSON-encoded to keep SQLite happy with arrays/objects)
  content   String   @default("{}")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, ordinal])
  @@index([messageId])
}

// ============================================================================
// AI PROVIDERS & MODELS
// ============================================================================

model ModelProvider {
  id           String   @id           // "openai" | "anthropic" | "google" | ...
  displayName  String
  apiBaseUrl   String?
  websiteUrl   String?
  // Sync state
  lastSyncedAt DateTime?
  syncStatus   String   @default("pending") // pending | ok | error | disabled
  syncError    String?
  // Visibility
  isEnabled    Boolean  @default(true)
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  models          ModelDefinition[]
  credentials     ProviderCredential[]
  pricingRules    PricingRule[]

  @@index([isEnabled])
}

model ModelDefinition {
  id                String   @id @default(cuid())
  providerId        String
  providerModelId   String   // e.g. "gpt-4o", "claude-3-5-sonnet-20241022"
  displayName       String
  family            String?  // e.g. "gpt-4o", "claude-3.5", "gemini-1.5"
  // Capabilities
  contextWindow     Int      @default(0)
  maxOutputTokens   Int      @default(0)
  inputModalities   String   @default("[\"text\"]")   // JSON
  outputModalities  String   @default("[\"text\"]")   // JSON
  supportsTools     Boolean  @default(false)
  supportsVision    Boolean  @default(false)
  supportsAudio     Boolean  @default(false)
  supportsReasoning Boolean  @default(false)
  supportsStreaming Boolean  @default(true)
  supportsStructuredOutput Boolean @default(false)
  supportsWebSearch Boolean  @default(false)
  // Pricing (per 1M tokens, in micro-cents to avoid floats)
  priceInputMicrosPer1M  Int @default(0)
  priceOutputMicrosPer1M Int @default(0)
  // Lifecycle
  status            String   @default("active") // active | deprecated | disabled
  deprecationNote   String?
  releaseDate       DateTime?
  // Admin
  isEnabledForUsers Boolean  @default(true)
  // Quality hints for Reklu Auto (1-100)
  qualityScore      Int      @default(50)
  speedScore        Int      @default(50)
  costScore         Int      @default(50)
  // Use-case tags
  recommendedFor    String   @default("[]") // JSON array
  // Timestamps
  lastSyncedAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  provider ModelProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  pricingRules PricingRule[]

  @@unique([providerId, providerModelId])
  @@index([status])
  @@index([isEnabledForUsers])
}

model ProviderCredential {
  id              String   @id @default(cuid())
  providerId      String
  userId          String?
  organizationId  String?
  // Encrypted at rest with ENCRYPTION_KEY
  encryptedKey    String
  // Scope
  scope           String   @default("user") // user | organization | system
  // Status
  isValid         Boolean  @default(false)
  lastValidatedAt DateTime?
  validationError String?
  // Optional base URL override
  baseUrl         String?
  // Metadata
  label           String?
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  revokedAt       DateTime?

  provider    ModelProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([providerId, scope])
  @@index([userId])
  @@index([organizationId])
}

model PricingRule {
  id              String   @id @default(cuid())
  providerId      String
  modelDefinitionId String?
  // Markup in basis points (100 = 1%)
  markupBps       Int      @default(0)
  // Effective price (set by admin, may override model default)
  priceInputMicrosPer1M  Int?
  priceOutputMicrosPer1M Int?
  // Plan access
  minPlan         String   @default("free") // free | pro | team | enterprise
  // Effective dates
  effectiveFrom   DateTime @default(now())
  effectiveUntil  DateTime?
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider        ModelProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modelDefinition ModelDefinition? @relation(fields: [modelDefinitionId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([modelDefinitionId])
}

// ============================================================================
// USAGE & BILLING LEDGER
// ============================================================================

model UsageEvent {
  id              String   @id @default(cuid())
  userId          String
  organizationId  String
  // What was used
  providerId      String
  modelId         String
  conversationId  String?
  messageId       String?
  // Counts
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  cachedInputTokens Int    @default(0)
  // Cost
  costMicros      Int      @default(0)
  // Context
  usageType       String   @default("chat") // chat | compare | skill | agent | artifact
  // Status
  status          String   @default("ok") // ok | error | rate_limited
  errorCode       String?
  // Timestamps
  createdAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([modelId, createdAt])
  @@index([conversationId])
}

model CreditLedgerEntry {
  id              String   @id @default(cuid())
  userId          String
  organizationId  String
  // Kind: grant | subscription | purchase | usage | refund | adjustment | expiration
  kind            String
  // Amount in micro-cents (positive for credits, negative for debits)
  amountMicros    Int
  // Balance after this entry (cached for fast reads)
  balanceMicros   Int
  // Description
  description     String?
  // External references
  stripePaymentId String?
  usageEventId    String?
  subscriptionId  String?
  // Effective date (for expirations)
  effectiveAt     DateTime @default(now())
  expiresAt       DateTime?
  // Admin
  createdByUserId String?
  // Timestamps
  createdAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([kind])
  @@index([effectiveAt])
}

model Subscription {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  // Stripe linkage
  stripeCustomerId       String?
  stripeSubscriptionId   String?  @unique
  stripePriceId          String?
  // Plan
  plan            String   @default("free") // free | pro | team | enterprise
  status          String   @default("inactive") // active | trialing | past_due | canceled | inactive
  // Allowance
  monthlyCreditMicros Int  @default(0)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  // Cancellation
  cancelAtPeriodEnd    Boolean @default(false)
  canceledAt           DateTime?
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([stripeCustomerId])
}

// ============================================================================
// AUDIT & NOTIFICATIONS
// ============================================================================

model AuditLog {
  id              String   @id @default(cuid())
  actorId         String?  // user id, or "system"
  actorType       String   @default("user") // user | system | admin
  action          String   // "user.created", "model.disabled", "credit.granted", ...
  // Target
  targetType      String?
  targetId        String?
  // Context
  ip              String?
  userAgent       String?
  metadata        String   @default("{}") // JSON
  // Timestamps
  createdAt       DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  // Content
  kind        String   // info | success | warning | error
  title       String
  body        String?
  link        String?
  // Read state
  readAt      DateTime?
  // Timestamps
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// ============================================================================
// SKILLS (Phase 4)
// ============================================================================

model Skill {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  category    String
  icon        String?
  status      String   @default("active")
  visibility  String   @default("public")
  usageCount  Int      @default(0)
  ratingSum   Int      @default(0)
  ratingCount Int      @default(0)
  creatorId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions      SkillVersion[]
  installations SkillInstallation[]
  runs          SkillRun[]
  evaluations   SkillEvaluation[]
  creator       User?     @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  @@index([status, category])
}

model SkillVersion {
  id                String   @id @default(cuid())
  skillId           String
  version           String
  intentRules       String   @default("[]")
  allowedModels     String   @default("[]")
  allowedTools      String   @default("[]")
  requiredConnectors String  @default("[]")
  systemPrompt      String
  workflowSteps     String   @default("[]")
  inputSchema       String   @default("{}")
  outputSchema      String   @default("{}")
  outputRenderer    String?
  examples          String   @default("[]")
  qualityChecks     String   @default("[]")
  evalRubric        String?
  safetyPolicy      String?
  isCurrent         Boolean  @default(true)
  changelog         String?
  createdAt         DateTime @default(now())
  createdById       String?

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, version])
  @@index([skillId, isCurrent])
}

model SkillInstallation {
  id             String   @id @default(cuid())
  skillId        String
  userId         String
  organizationId String?
  enabled        Boolean  @default(true)
  installedAt    DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, userId])
  @@index([userId])
}

model SkillRun {
  id             String   @id @default(cuid())
  skillId        String
  skillVersionId String?
  userId         String
  organizationId String?
  conversationId String?
  input          String   @default("{}")
  output         String?
  outputText     String?
  status         String   @default("pending")
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  durationMs     Int?
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costMicros     Int      @default(0)
  rating         Int?
  errorCode      String?
  errorMessage   String?
  steps          String   @default("[]")

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([skillId, status])
  @@index([organizationId, startedAt])
}

model SkillEvaluation {
  id             String   @id @default(cuid())
  skillId        String
  skillVersionId String?
  testName       String
  testCases      String   @default("[]")
  passRate       Float    @default(0)
  avgScore       Float    @default(0)
  avgLatencyMs   Int      @default(0)
  avgCostMicros  Int      @default(0)
  results        String   @default("[]")
  runAt          DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId, runAt])
}

// ============================================================================
// CONNECTORS (Phase 5)
// ============================================================================

model ConnectorDefinition {
  id                 String   @id @default(cuid())
  name               String
  description        String
  category           String
  iconUrl            String?
  authType           String
  oauthAuthorizeUrl  String?
  oauthTokenUrl      String?
  oauthScopes        String?
  capabilities       String   @default("[]")
  supportsSync       Boolean  @default(false)
  syncStrategy       String?
  isEnabled          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  accounts ConnectorAccount[]

  @@index([isEnabled])
}

model ConnectorAccount {
  id                     String   @id @default(cuid())
  definitionId           String
  userId                 String
  organizationId         String
  encryptedAccessToken   String?
  encryptedRefreshToken  String?
  expiresAt              DateTime?
  externalAccountId      String?
  externalAccountLabel   String?
  scopes                 String   @default("[]")
  lastSyncedAt           DateTime?
  syncCursor             String?
  syncStatus             String   @default("pending")
  syncError              String?
  revokedAt              DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  definition ConnectorDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  items      ConnectorItem[]

  @@unique([definitionId, userId, externalAccountId])
  @@index([userId])
  @@index([organizationId])
}

model ConnectorItem {
  id           String   @id @default(cuid())
  accountId    String
  externalId   String
  externalType String
  title        String
  preview      String?
  url          String?
  metadata     String   @default("{}")
  lastSeenAt   DateTime @default(now())
  indexedAt    DateTime?

  account ConnectorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalId])
  @@index([accountId, externalType])
}

// ============================================================================
// MCP (Phase 5)
// ============================================================================

model MCPServer {
  id                 String   @id @default(cuid())
  userId             String
  organizationId     String
  name               String
  description        String?
  publisher          String?
  url                String
  transport          String   @default("http")
  authType           String   @default("none")
  encryptedCredential String?
  trustLevel         String   @default("community")
  publisherVerified  Boolean  @default(false)
  status             String   @default("pending")
  lastConnectedAt    DateTime?
  lastError          String?
  capabilities       String   @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  revokedAt          DateTime?

  toolApprovals MCPToolApproval[]
  toolCalls     MCPToolCall[]

  @@index([userId, status])
  @@index([organizationId])
}

model MCPToolApproval {
  id        String   @id @default(cuid())
  serverId  String
  toolName  String
  policy    String   @default("ask")
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime?

  server MCPServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, toolName, userId])
  @@index([userId])
}

model MCPToolCall {
  id             String   @id @default(cuid())
  serverId       String
  toolName       String
  userId         String
  organizationId String
  input          String   @default("{}")
  output         String?
  status         String   @default("ok")
  errorCode      String?
  errorMessage   String?
  approvalStatus String   @default("auto")
  durationMs     Int?
  startedAt      DateTime @default(now())
  completedAt    DateTime?

  server MCPServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([serverId, toolName])
}

// ============================================================================
// FILES & RAG (Phase 6)
// ============================================================================

model FileAsset {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  name           String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  storageBackend String   @default("local")
  extractedText  String?
  pageCount      Int?
  wordCount      Int?
  status         String   @default("pending")
  errorMessage   String?
  sourceType     String   @default("upload")
  sourceRef      String?
  visibility     String   @default("private")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  chunks FileChunk[]

  @@index([userId, createdAt])
  @@index([organizationId, status])
  @@index([sourceType, sourceRef])
}

model FileChunk {
  id        String   @id @default(cuid())
  fileId    String
  ordinal   Int
  text      String
  pageStart Int?
  pageEnd   Int?
  charStart Int?
  charEnd   Int?
  embedding String?
  metadata  String   @default("{}")

  file FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, ordinal])
  @@index([fileId])
}

// ============================================================================
// ARTIFACTS (Phase 6)
// ============================================================================

model Artifact {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  kind           String
  title          String
  content        String   @default("")
  metadata       String   @default("{}")
  currentVersion Int      @default(1)
  projectId      String?
  conversationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  versions ArtifactVersion[]

  @@index([userId, kind, updatedAt])
  @@index([organizationId])
  @@index([projectId])
}

model ArtifactVersion {
  id          String   @id @default(cuid())
  artifactId  String
  version     Int
  content     String
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())
  createdById String?

  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([artifactId, version])
}

// ============================================================================
// IMAGE GENERATIONS (Phase 6)
// ============================================================================

model ImageGeneration {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  prompt         String
  revisedPrompt  String?
  providerId     String
  modelId        String
  imageUrl       String
  width          Int
  height         Int
  seed           Int?
  steps          Int?
  costMicros     Int      @default(0)
  artifactId     String?
  parentImageId  String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([organizationId])
}
