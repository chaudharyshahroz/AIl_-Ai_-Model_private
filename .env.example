# ============================================
# REKLU — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# Never commit .env to source control.

# --------------------------------------------
# Application
# --------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Reklu

# --------------------------------------------
# Database (Phase 1-3: SQLite for local dev.
# Postgres recommended for production.)
# --------------------------------------------
DATABASE_URL="file:./dev.db"
# Production example:
# DATABASE_URL="postgresql://reklu:password@localhost:5432/reklu?schema=public"

# --------------------------------------------
# Authentication
# --------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"
# Required when running behind a reverse proxy or when the dev port shifts.
# NextAuth uses the request's host when AUTH_URL is unset.
AUTH_TRUST_HOST=true
# Only set AUTH_URL in production with a fixed domain. In dev, leave it unset
# so it auto-detects the port (3000, 3001, 3002, etc.).
# AUTH_URL=https://reklu.app

# Google OAuth (optional but recommended)
# See docs/GOOGLE_OAUTH.md for setup
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------------------------
# Encryption (for provider API keys, connector tokens)
# --------------------------------------------
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-me-with-a-random-32-byte-base64-string"

# --------------------------------------------
# AI Provider Keys (Reklu-managed and/or BYOK)
# These are server-side only — never exposed to the browser.
# At minimum, set one of these to enable chat.
# --------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Optional — additional providers for Phase 4+
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
MOONSHOT_API_KEY=
QWEN_API_KEY=
PERPLEXITY_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
MINIMAX_API_KEY=

# --------------------------------------------
# Object Storage (S3-compatible) — Phase 6
# --------------------------------------------
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=reklu-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --------------------------------------------
# Redis (background jobs) — Phase 6
# --------------------------------------------
# REDIS_URL=redis://localhost:6379

# --------------------------------------------
# Email (transactional) — Phase 6+
# --------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM=hello@reklu.app

# --------------------------------------------
# Stripe (billing) — Phase 8
# --------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --------------------------------------------
# Observability
# --------------------------------------------
# SENTRY_DSN=
# LOG_LEVEL=info

# --------------------------------------------
# Feature Flags
# --------------------------------------------
FEATURE_REKLU_AUTO=true
FEATURE_MODEL_COMPARISON=true
FEATURE_FILES=false
FEATURE_SKILLS=false
FEATURE_CONNECTORS=false
FEATURE_MCP=false
FEATURE_AGENTS=false
FEATURE_ARTIFACTS=false
FEATURE_BILLING=false
FEATURE_ADMIN=false
